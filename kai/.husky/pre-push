#!/usr/bin/env sh
# KAI build tripwire — blocks a push that would fail the Vercel build.
# Enable locally with:  git config core.hooksPath .husky
. "$(dirname -- "$0")/_/husky.sh" 2>/dev/null || true
cd "$(git rev-parse --show-toplevel)/kai" 2>/dev/null || cd kai 2>/dev/null || true
node scripts/preflight.mjs
